# Backend only. Copy this file to .env; never commit actual keys.
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only secret/service-role key, needed to permanently delete accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables AI chat, prayer reflections, narration and transcription.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
DAILY_AI_CREDITS=40

# Comma-separated web origins if you enable a web client. Native apps need no CORS origin.
ALLOWED_ORIGINS=
# Set only for the known number of trusted proxies in front of your deployment.
TRUST_PROXY=0

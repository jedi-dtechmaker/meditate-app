{
  "name": "meditate-on-the-word",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "mobile": "npm run start --workspace @meditate/mobile",
    "android": "npm run android --workspace @meditate/mobile",
    "build": "npm run typecheck && npm run bundle:android",
    "lint": "npm run typecheck && npm run lint --workspace @meditate/mobile",
    "typecheck": "tsc --noEmit -p tsconfig.api.json && npm run typecheck --workspace @meditate/mobile",
    "test": "tsx --test tests/*.test.ts",
    "bundle:android": "npm exec --workspace @meditate/mobile -- expo export --platform android"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.80.0",
    "dotenv": "^17.2.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/cors": "^2.8.19",
    "typescript": "~6.0.3",
    "@types/express": "^4.17.21"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  }
}
